" BEGIN voidplacer JetBrains profile
" Match Zed's Vim editing and relative line numbers.
set clipboard+=unnamedplus
set number relativenumber
set scrolloff=5

" IdeaVim handles editor focus. Keep its proven split movement in both modes.
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
inoremap <C-h> <Esc><C-w>h
inoremap <C-j> <Esc><C-w>j
inoremap <C-k> <Esc><C-w>k
inoremap <C-l> <Esc><C-w>l
" END voidplacer JetBrains profile
